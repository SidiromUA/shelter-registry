<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<a class="skip-link" href="#main">Перейти до основного вмісту</a>
<header class="site-header">
  <p class="logo">Реєстр укриттів</p>
  <nav aria-label="Основна навігація">
    <ul>
      <li><a href="${pageContext.request.contextPath}/shelters">Укриття</a></li>
      <c:choose>
        <c:when test="${not empty sessionScope.user}">
          <li><span><c:out value="${sessionScope.user.fullName()}"/> (<c:out value="${sessionScope.user.role()}"/>)</span></li>
          <li>
            <form action="${pageContext.request.contextPath}/logout" method="post" class="inline">
              <button type="submit" class="link-button">Вийти</button>
            </form>
          </li>
        </c:when>
        <c:otherwise>
          <li><a href="${pageContext.request.contextPath}/login">Увійти</a></li>
        </c:otherwise>
      </c:choose>
    </ul>
  </nav>
</header>
